<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity Name="FluentCanvas.LocalTest" Publisher="CN=FluentCanvas Local Test" Version="26.11.22.0" />

  <Properties>
    <DisplayName>FluentCanvas</DisplayName>
    <PublisherDisplayName>FluentCanvas Local Test</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="zh-CN" />
    <Resource Language="en-US" />
    <Resource Language="zh-TW" />
    <Resource Language="ja-JP" />
    <Resource Language="hi" />
    <Resource Language="es" />
    <Resource Language="ar" />
    <Resource Language="fr" />
    <Resource Language="bn" />
    <Resource Language="pt" />
    <Resource Language="ru" />
    <Resource Language="id" />
    <Resource Language="ur" />
    <Resource Language="de" />
    <Resource Language="mr" />
    <Resource Language="vi" />
    <Resource Language="te" />
    <Resource Language="tr" />
    <Resource Language="ta" />
    <Resource Language="ko" />
    <Resource Language="fa" />
    <Resource Language="ha-Latn-NG" />
    <Resource Language="sw-KE" />
    <Resource Language="th" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="FluentCanvas.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="FluentCanvas"
        Description="FluentCanvas"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"  Square71x71Logo="Assets\SmallTile.png" Square310x310Logo="Assets\LargeTile.png"/>
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="fluentcanvas">
            <uap:DisplayName>FluentCanvas File</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.icart</uap:FileType>
              <uap:FileType>.icstk</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <desktop:Extension Category="windows.startupTask" Executable="FluentCanvas.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="FluentCanvasStartup" Enabled="false" DisplayName="FluentCanvas" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
