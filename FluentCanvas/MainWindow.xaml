                                            OnContent=""
                                            Toggled="ToggleSwitchEnableTwoFingerTranslate_Toggled" />
                                    </Viewbox>
                                </ikw:SimpleStackPanel>
                                <ikw:SimpleStackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Opacity="{Binding ElementName=TwoFingerGestureSimpleStackPanel, Path=Opacity}"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <ui:FontIcon
                                        Width="20"
                                        Height="20"
                                        Margin="0,4,0,2"
                                        FontFamily="{StaticResource FluentIconFontFamily}"
                                        FontSize="16"
                                        Foreground="{DynamicResource FloatBarForeground}"
                                        Glyph="&#xe740;" />
                                    <Label
                                        VerticalAlignment="Center"
                                        Content="{loc:Text Canvas.TwoFingerZoom}"
                                        FontSize="12"
                                        Foreground="{DynamicResource FloatBarForeground}" />
                                    <Viewbox Width="36" Height="25">
                                        <ui:ToggleSwitch
                                            Name="ToggleSwitchEnableTwoFingerZoom"
                                            Width="42"
                                            MinWidth="0"
                                            IsOn="False"
                                            OffContent=""
                                            OnContent=""
                                            Toggled="ToggleSwitchEnableTwoFingerZoom_Toggled" />
                                    </Viewbox>
                                </ikw:SimpleStackPanel>
                                <ikw:SimpleStackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Opacity="{Binding ElementName=TwoFingerGestureSimpleStackPanel, Path=Opacity}"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <ui:FontIcon
                                        Width="20"
                                        Height="20"
                                        Margin="0,4,0,2"
                                        FontFamily="{StaticResource FluentIconFontFamily}"
                                        FontSize="16"
                                        Foreground="{DynamicResource FloatBarForeground}"
                                        Glyph="&#xe7ad;" />
                                    <Label
                                        VerticalAlignment="Center"
                                        Content="{loc:Text Canvas.TwoFingerRotate}"
                                        FontSize="12"
                                        Foreground="{DynamicResource FloatBarForeground}" />
                                    <Viewbox Width="36" Height="25">
                                        <ui:ToggleSwitch
                                            Name="ToggleSwitchEnableTwoFingerRotation"
                                            Width="42"
                                            MinWidth="0"
                                            OffContent=""
                                            OnContent=""
                                            Toggled="ToggleSwitchEnableTwoFingerRotation_Toggled" />
                                    </Viewbox>
                                </ikw:SimpleStackPanel>
                            </ikw:SimpleStackPanel>
                        </ikw:SimpleStackPanel>
                    </Border>
                </Grid>

                <Border
                    x:Name="BtnPPTSlideShowEnd"
                    Width="34"
                    Height="36"
                    Margin="4,0,0,0"
                    Style="{StaticResource FloatingToolbarSurfaceStyle}"
                    Visibility="Visible">
                    <Button
                        AutomationProperties.Name="{loc:Text Canvas.EndSlideShow}"
                        BorderThickness="0"
                        Click="BtnPPTSlideShowEnd_Click">
                        <Image
                            Width="30"
                            Height="20"
                            Source="{DynamicResource ResourceKey=PPTExitNormal}" />
                    </Button>
                </Border>
            </ikw:SimpleStackPanel>
        </Viewbox>
        <!--  // 浮动工具栏拖动 //  -->
        <Grid
            Name="GridForFloatingBarDraging"
            Background="#01000000"
            MouseMove="FloatingToolbarDrag_MouseMove"
            MouseUp="FloatingToolbarDrag_MouseUp"
            Visibility="Collapsed" />
        <!--  // 墨迹播放 //  -->
        <InkCanvas
            Name="InkCanvasForInkReplay"
            Background="Transparent"
            EditingMode="None"
            MouseDown="InkCanvasForInkReplay_MouseDown"
            Visibility="Collapsed" />
        <!--  // 侧边栏 //  -->
        <Button
            x:Name="LeftSidePanel"
            Width="30"
            Height="50"
            Margin="-40,0,0,-150"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Background="{DynamicResource FloatingToolbarSurfaceBrush}"
            BorderBrush="{DynamicResource FloatingToolbarStrokeBrush}"
            BorderThickness="1"
            AutomationProperties.Name="{loc:Text Canvas.ExpandFromLeft}"
            Command="{StaticResource ToolbarUnfold}"
            Style="{StaticResource FloatingToolbarButtonStyle}"
            Visibility="Collapsed">
            <ui:FontIcon
                Margin="14,0,0,0"
                FontFamily="{StaticResource FluentIconFontFamily}"
                FontSize="10"
                Foreground="{DynamicResource FloatBarForeground}"
                Glyph="&#xe76c;" />
        </Button>
        <Button
            x:Name="RightSidePanel"
            Width="30"
            Height="50"
            Margin="0,0,-40,-150"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Background="{DynamicResource FloatingToolbarSurfaceBrush}"
            BorderBrush="{DynamicResource FloatingToolbarStrokeBrush}"
            BorderThickness="1"
            AutomationProperties.Name="{loc:Text Canvas.ExpandFromRight}"
            Command="{StaticResource ToolbarUnfold}"
            Style="{StaticResource FloatingToolbarButtonStyle}"
            Visibility="{Binding ElementName=LeftSidePanel, Path=Visibility}">
            <ui:FontIcon
                Margin="0,0,14,0"
                FontFamily="{StaticResource FluentIconFontFamily}"
                FontSize="10"
                Foreground="{DynamicResource FloatBarForeground}"
                Glyph="&#xe76b;" />
        </Button>
    </Grid>
</Window>
