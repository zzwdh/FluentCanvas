<Window
    x:Class="FluentCanvas.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="http://schemas.microsoft.com/netfx/2009/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:FluentCanvas.Helpers"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:loc="clr-namespace:FluentCanvas.Localization"
    xmlns:local="clr-namespace:FluentCanvas"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:views="clr-namespace:FluentCanvas.Views"
    Name="window"
    Language="{x:Static loc:WpfLanguage.Language}"
    Title="{loc:Text Canvas.WindowTitle}"
    Width="1440"
    Height="5500"
    AllowsTransparency="True"
    Background="Transparent"
    Closed="Window_Closed"
    Closing="Window_Closing"
    Foreground="{DynamicResource FloatBarForeground}"
    KeyDown="Window_KeyDown"
    Loaded="Window_Loaded"
    MouseWheel="Window_MouseWheel"
    PreviewKeyDown="Main_Grid_PreviewKeyDown"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Stylus.IsPressAndHoldEnabled="False"
    Topmost="True"
    WindowState="Maximized"
    WindowStyle="None"
    mc:Ignorable="d">
    <!--  资源中添加命令  -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/BoardDrawShapeImageDictionary.xaml" />
                <ResourceDictionary Source="/Resources/DrawShapeImageDictionary.xaml" />
                <ResourceDictionary Source="/Resources/IconImageDictionary.xaml" />
                <ResourceDictionary Source="/Resources/Styles/ToolbarButtons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <RoutedUICommand x:Key="ToolbarUndo" Text="{loc:Text Canvas.Undo}" />
            <RoutedUICommand x:Key="ToolbarRedo" Text="{loc:Text Canvas.Redo}" />
            <RoutedUICommand x:Key="ToolbarSelect" Text="{loc:Text Canvas.Select}" />
            <RoutedUICommand x:Key="ToolbarPen" Text="{loc:Text Canvas.Pen}" />
            <RoutedUICommand x:Key="ToolbarEraser" Text="{loc:Text Canvas.Eraser}" />
            <RoutedUICommand x:Key="ToolbarEraseStrokes" Text="{loc:Text Canvas.EraseStrokes}" />
            <RoutedUICommand x:Key="ToolbarUnfold" Text="{loc:Text Canvas.ExpandToolbar}" />
            <RoutedUICommand x:Key="HotKey_ChangeToEraser" Text=" " />
            <RoutedUICommand x:Key="HotKey_ChangeToPen1" Text=" " />
            <RoutedUICommand x:Key="HotKey_ChangeToPen2" Text=" " />
            <RoutedUICommand x:Key="HotKey_ChangeToPen3" Text=" " />
            <RoutedUICommand x:Key="HotKey_ChangeToPen4" Text=" " />
            <RoutedUICommand x:Key="HotKey_ChangeToPen5" Text=" " />
            <RoutedUICommand x:Key="HotKey_DrawLine" Text=" " />

            <Geometry x:Key="TrianglePaletteIcon">M3,19 L11,4 21,19 Z</Geometry>
            <Geometry x:Key="AnglePaletteIcon">M21,19 H4 L16,6 M9,14 Q12,16 12,19</Geometry>
            <Geometry x:Key="ArcPaletteIcon">M4,18 A14,14 0 0 1 18,4</Geometry>
            <Geometry x:Key="NumberLinePaletteIcon">M2,12 H21 L17,8 M21,12 L17,16 M5,9 V15 M9,9 V15 M13,9 V15</Geometry>
            <Geometry x:Key="ParallelogramPaletteIcon">M3,18 L7,6 H21 L17,18 Z</Geometry>
            <Geometry x:Key="TrapezoidPaletteIcon">M3,18 L7,6 H17 L21,18 Z</Geometry>
            <Geometry x:Key="SpherePaletteIcon">M12,2 A10,10 0 1 1 12,22 A10,10 0 1 1 12,2 Z M2,12 C2,17 22,17 22,12 M3,10.5 L5,9.5 M8,9 L10,8.8 M14,8.8 L16,9 M19,9.5 L21,10.5</Geometry>
            <Geometry x:Key="TetrahedronPaletteIcon">M3,17 L11,3 21,16 13,21 Z M11,3 L13,21 M3,17 L6,16.8 M9,16.6 L12,16.4 M15,16.2 L18,16.1</Geometry>
            <Geometry x:Key="BoundingEllipsePaletteIcon">M3,12 A9,6 0 1 1 21,12 A9,6 0 1 1 3,12 Z M2,7 V5 H4 M20,19 H22 V17</Geometry>

            <DataTemplate x:Key="ShapePaletteIconTemplate">
                <Path
                    Width="22"
                    Height="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Data="{Binding}"
                    FlowDirection="LeftToRight"
                    Stretch="Uniform"
                    Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="1.6" />
            </DataTemplate>

            <Style x:Key="ShapePresetButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
                <Setter Property="ContentTemplate" Value="{StaticResource ShapePaletteIconTemplate}" />
                <Setter Property="Foreground" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                <Setter Property="Height" Value="34" />
            </Style>

            <Style x:Key="ShapeVariantStyle" TargetType="MenuItem">
                <Setter Property="AutomationProperties.Name" Value="{Binding Header, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Focusable" Value="True" />
                <Setter Property="Foreground" Value="{DynamicResource FloatBarForeground}" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border
                                x:Name="VariantSurface"
                                Padding="11,5"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="4">
                                <ContentPresenter
                                    VerticalAlignment="Center"
                                    ContentSource="Header"
                                    RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="VariantSurface" Property="Background" Value="{DynamicResource FloatingToolbarHoverBrush}" />
                                    <Setter TargetName="VariantSurface" Property="BorderBrush" Value="{DynamicResource FloatingToolbarHoverStrokeBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ShapeGroupStyle" TargetType="MenuItem">
                <Setter Property="Focusable" Value="True" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource ToolbarKeyboardFocus}" />
                <Setter Property="Foreground" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                <Setter Property="HeaderTemplate" Value="{StaticResource ShapePaletteIconTemplate}" />
                <Setter Property="Height" Value="34" />
                <Setter Property="IsTabStop" Value="True" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource ShapeVariantStyle}" />
                <Setter Property="ToolTip" Value="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource Self}}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Grid>
                                <Border
                                    x:Name="GroupSurface"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                    <Grid>
                                        <ContentPresenter
                                            Margin="0,0,8,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            ContentSource="Header" />
                                        <Path
                                            Margin="0,0,4,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Data="M0,0 L3,3 6,0"
                                            Stroke="{TemplateBinding Foreground}"
                                            StrokeThickness="1.4" />
                                    </Grid>
                                </Border>
                                <Popup
                                    x:Name="PART_Popup"
                                    AllowsTransparency="True"
                                    Focusable="False"
                                    IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                    Placement="Bottom"
                                    PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border
                                        Padding="3"
                                        Style="{StaticResource FloatingToolbarSurfaceStyle}">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="GroupSurface" Property="Background" Value="{DynamicResource FloatingToolbarHoverBrush}" />
                                    <Setter TargetName="GroupSurface" Property="BorderBrush" Value="{DynamicResource FloatingToolbarHoverStrokeBrush}" />
                                </Trigger>
                                <Trigger Property="IsSubmenuOpen" Value="True">
                                    <Setter TargetName="GroupSurface" Property="Background" Value="{DynamicResource FloatingToolbarSelectedBrush}" />
                                    <Setter TargetName="GroupSurface" Property="BorderBrush" Value="{DynamicResource FloatingToolbarHoverStrokeBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="AdditionalShapePresets">
                <StackPanel Margin="8,0,8,5">
                    <Border
                        Margin="2,0,2,2"
                        BorderBrush="{DynamicResource FloatingToolbarStrokeBrush}"
                        BorderThickness="0,0,0,1"
                        IsHitTestVisible="False" />
                    <Menu
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        FlowDirection="{x:Static loc:WpfLanguage.TextDirection}"
                        IsMainMenu="False"
                        ItemContainerStyle="{StaticResource ShapeGroupStyle}">
                        <Menu.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </Menu.ItemsPanel>
                        <MenuItem
                            AutomationProperties.Name="{loc:Text Canvas.TriangleVariants}"
                            Header="{StaticResource TrianglePaletteIcon}">
                            <MenuItem Click="NewShapeButton_Click" Header="{loc:Text Canvas.Triangle}" Tag="Triangle" />
                            <MenuItem Click="NewShapeButton_Click" Header="{loc:Text Canvas.RightTriangle}" Tag="RightTriangle" />
                            <MenuItem Click="NewShapeButton_Click" Header="{loc:Text Canvas.IsoscelesTriangle}" Tag="IsoscelesTriangle" />
                            <MenuItem Click="NewShapeButton_Click" Header="{loc:Text Canvas.EquilateralTriangle}" Tag="EquilateralTriangle" />
                        </MenuItem>
                        <MenuItem
                            AutomationProperties.Name="{loc:Text Canvas.AngleMarks}"
                            Header="{StaticResource AnglePaletteIcon}">
                            <MenuItem Click="NewShapeButton_Click" Header="{loc:Text Canvas.AngleMark}" Tag="AngleMark" />
                            <MenuItem Click="NewShapeButton_Click" Header="{loc:Text Canvas.RightAngleMark}" Tag="RightAngleMark" />
                        </MenuItem>
                        <MenuItem
                            AutomationProperties.Name="{loc:Text Canvas.CircularShapes}"
                            Header="{StaticResource ArcPaletteIcon}">
                            <MenuItem Click="NewShapeButton_Click" Header="{loc:Text Canvas.Arc}" Tag="Arc" />
                            <MenuItem Click="NewShapeButton_Click" Header="{loc:Text Canvas.Sector}" Tag="Sector" />
                            <MenuItem
                                AutomationProperties.HelpText="{loc:Text Canvas.DrawSemicircle}"
                                Click="NewShapeButton_Click"
                                Header="{loc:Text Canvas.Semicircle}"
                                Tag="Semicircle"
                                ToolTip="{loc:Text Canvas.DrawSemicircle}" />
                        </MenuItem>
                        <MenuItem
                            AutomationProperties.Name="{loc:Text Canvas.NumberLine}"
                            Header="{StaticResource NumberLinePaletteIcon}">
                            <MenuItem Click="NewShapeButton_Click" Header="{loc:Text Canvas.NumberLineTicks}" Tag="NumberLine" />
                            <MenuItem Click="NewShapeButton_Click" Header="{loc:Text Canvas.NumberLineLabeled}" Tag="NumberLineLabeled" />
                        </MenuItem>
                    </Menu>
                    <UniformGrid Rows="1">
                        <Button
                            AutomationProperties.Name="{loc:Text Canvas.Parallelogram}"
                            Click="NewShapeButton_Click"
                            Content="{StaticResource ParallelogramPaletteIcon}"
                            Style="{StaticResource ShapePresetButtonStyle}"
                            Tag="Parallelogram" />
                        <Button
                            AutomationProperties.Name="{loc:Text Canvas.Trapezoid}"
                            Click="NewShapeButton_Click"
                            Content="{StaticResource TrapezoidPaletteIcon}"
                            Style="{StaticResource ShapePresetButtonStyle}"
                            Tag="Trapezoid" />
                        <Button
                            AutomationProperties.Name="{loc:Text Canvas.BoundingEllipse}"
                            Click="BtnDrawEllipse_Click"
                            Content="{StaticResource BoundingEllipsePaletteIcon}"
                            Style="{StaticResource ShapePresetButtonStyle}" />
                        <Button
                            AutomationProperties.Name="{loc:Text Canvas.Sphere}"
                            Click="NewShapeButton_Click"
                            Content="{StaticResource SpherePaletteIcon}"
                            Style="{StaticResource ShapePresetButtonStyle}"
                            Tag="Sphere" />
                        <Button
                            AutomationProperties.Name="{loc:Text Canvas.Tetrahedron}"
                            Click="NewShapeButton_Click"
                            Content="{StaticResource TetrahedronPaletteIcon}"
                            Style="{StaticResource ShapePresetButtonStyle}"
                            Tag="Tetrahedron" />
                    </UniformGrid>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <!--  输入命令绑定  -->
    <Window.InputBindings>
        <KeyBinding
            Key="Z"
            Command="{StaticResource ToolbarUndo}"
            Modifiers="Control" />
        <KeyBinding
            Key="Y"
            Command="{StaticResource ToolbarRedo}"
            Modifiers="Control" />
        <KeyBinding
            Key="S"
            Command="{StaticResource ToolbarSelect}"
            Modifiers="Alt" />
        <KeyBinding
            Key="E"
            Command="{StaticResource HotKey_ChangeToEraser}"
            Modifiers="Alt" />
        <KeyBinding
            Key="D1"
            Command="{StaticResource HotKey_ChangeToPen1}"
            Modifiers="Alt" />
        <KeyBinding
            Key="D2"
            Command="{StaticResource HotKey_ChangeToPen2}"
            Modifiers="Alt" />
        <KeyBinding
            Key="D3"
            Command="{StaticResource HotKey_ChangeToPen3}"
            Modifiers="Alt" />
        <KeyBinding
            Key="D4"
            Command="{StaticResource HotKey_ChangeToPen4}"
            Modifiers="Alt" />
        <KeyBinding
            Key="D5"
            Command="{StaticResource HotKey_ChangeToPen5}"
            Modifiers="Alt" />
        <KeyBinding
            Key="L"
            Command="{StaticResource HotKey_DrawLine}"
            Modifiers="Alt" />
    </Window.InputBindings>
    <!--  命令执行方法绑定  -->
    <Window.CommandBindings>
        <CommandBinding
            CanExecute="Undo_CanExecute"
            Command="{StaticResource ToolbarUndo}"
            Executed="HotKey_Undo" />
        <CommandBinding
            CanExecute="Redo_CanExecute"
            Command="{StaticResource ToolbarRedo}"
            Executed="HotKey_Redo" />
        <CommandBinding
            CanExecute="CommandBinding_CanExecute"
            Command="{StaticResource ToolbarSelect}"
            Executed="KeyChangeToSelect" />
        <CommandBinding
            CanExecute="CommandBinding_CanExecute"
            Command="{StaticResource HotKey_ChangeToEraser}"
            Executed="KeyChangeToEraser" />
        <CommandBinding
            CanExecute="CommandBinding_CanExecute"
            Command="{StaticResource HotKey_DrawLine}"
            Executed="KeyDrawLine" />
        <CommandBinding
            CanExecute="CommandBinding_CanExecute"
            Command="{StaticResource ToolbarPen}"
            Executed="ToolbarUsePen" />
        <CommandBinding
            CanExecute="CommandBinding_CanExecute"
            Command="{StaticResource ToolbarEraser}"
            Executed="ToolbarUseEraser" />
        <CommandBinding
            CanExecute="CommandBinding_CanExecute"
            Command="{StaticResource ToolbarEraseStrokes}"
            Executed="ToolbarEraseStrokes" />
        <CommandBinding
            CanExecute="CommandBinding_CanExecute"
            Command="{StaticResource ToolbarUnfold}"
            Executed="ToolbarUnfold" />
    </Window.CommandBindings>
    <Grid x:Name="Main_Grid" Background="#01FFFFFF">
        <!--  // 画板幕布 //  -->
        <Grid Name="GridBackgroundCoverHolder">
            <Grid
                Name="GridBackgroundCover"
                Background="{DynamicResource BoardCanvasBackground}"
                Visibility="Collapsed" />
        </Grid>
        <!--  // 画板 //  -->
        <local:ShapeDraftInkCanvas
            x:Name="inkCanvas"
            Background="Transparent"
            Cursor="Pen"
            EditingModeChanged="inkCanvas_EditingModeChanged"
            ForceCursor="False"
            IsManipulationEnabled="True"
            LostMouseCapture="InkCanvas_LostShapeMouseCapture"
            LostTouchCapture="InkCanvas_LostShapeTouchCapture"
            ManipulationCompleted="Main_Grid_ManipulationCompleted"
            ManipulationDelta="Main_Grid_ManipulationDelta"
            ManipulationInertiaStarting="inkCanvas_ManipulationInertiaStarting"
            ManipulationStarting="inkCanvas_ManipulationStarting"
            MouseDown="inkCanvas_MouseDown"
            MouseMove="inkCanvas_MouseMove"
            MouseUp="inkCanvas_MouseUp"
            PreviewTouchDown="InkCanvas_PreviewShapeTouchDown"
            PreviewTouchMove="InkCanvas_PreviewNewShapeTouchMove"
            PreviewTouchUp="InkCanvas_PreviewShapeTouchUp"
            SelectionChanged="inkCanvas_SelectionChanged"
            StrokeCollected="inkCanvas_StrokeCollected"
            TouchDown="Main_Grid_TouchDown"
            TouchMove="inkCanvas_TouchMove"
            TouchUp="Main_Grid_TouchUp" />
        <Border
            x:Name="ShapePlacementHint"
            MaxWidth="480"
            Margin="16,16,16,0"
            Padding="12,7"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            Style="{StaticResource FloatingToolbarSurfaceStyle}"
            Visibility="Collapsed">
            <TextBlock
                x:Name="ShapePlacementHintText"
                AutomationProperties.LiveSetting="Polite"
                FlowDirection="{x:Static loc:WpfLanguage.TextDirection}"
                FontSize="14"
                Foreground="{DynamicResource FloatBarForeground}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </Border>
        <!--  // 选择选项窗口 //  -->
        <Grid Visibility="{Binding ElementName=inkCanvas, Path=Visibility}">
            <Grid
                Name="GridInkCanvasSelectionCover"
                Background="#01FFFFFF"
                IsManipulationEnabled="True"
                ManipulationCompleted="GridInkCanvasSelectionCover_ManipulationCompleted"
                ManipulationDelta="GridInkCanvasSelectionCover_ManipulationDelta"
                ManipulationStarting="GridInkCanvasSelectionCover_ManipulationStarting"
                MouseDown="GridInkCanvasSelectionCover_MouseDown"
                MouseMove="GridInkCanvasSelectionCover_MouseMove"
                MouseUp="GridInkCanvasSelectionCover_MouseUp"
                MouseWheel="GridInkCanvasSelectionCover_MouseWheel"
                Opacity="0.01"
                PreviewTouchDown="GridInkCanvasSelectionCover_PreviewTouchDown"
                PreviewTouchUp="GridInkCanvasSelectionCover_PreviewTouchUp"
                Visibility="Visible" />
            <Canvas x:Name="ShapeHandles" ClipToBounds="True"
                    Visibility="{Binding ElementName=GridInkCanvasSelectionCover, Path=Visibility}" />
            <Border
                x:Name="BorderStrokeSelectionControl"
                Height="104"
                Margin="0,50,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{DynamicResource FloatBarBackground}"
                BorderBrush="{DynamicResource FloatBarBorderBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Visibility="{Binding ElementName=GridInkCanvasSelectionCover, Path=Visibility}">
                <Viewbox>
                    <ikw:SimpleStackPanel>
                        <ikw:SimpleStackPanel
                            Height="80"
                            Orientation="Horizontal"
                            Spacing="6">
                            <ikw:SimpleStackPanel
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <Border CornerRadius="5">
                                    <ToggleButton
                                        x:Name="ToggleButtonStrokeSelectionClone"
                                        Width="90"
                                        Height="35"
                                        Padding="0"
                                        IsChecked="False">
                                        <ikw:SimpleStackPanel
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="2">
                                            <ui:FontIcon
                                                Width="18"
                                                Height="18"
                                                FontFamily="{StaticResource FluentIconFontFamily}"
                                                FontSize="16"
                                                Glyph="&#xe8c8;" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                FlowDirection="{x:Static loc:WpfLanguage.TextDirection}"
                                                Text="{loc:Text Canvas.CloneMode}" />
                                        </ikw:SimpleStackPanel>
                                    </ToggleButton>
                                </Border>
                                <Button
                                    Width="90"
                                    Height="35"
                                    Padding="0"
                                    Background="{DynamicResource FloatBarBackground}"
                                    Click="BorderStrokeSelectionCloneToBoardOrNewPage_Click">
                                    <ikw:SimpleStackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="2">
                                        <ui:FontIcon
                                            Width="18"
                                            Height="18"
                                            FontFamily="{StaticResource FluentIconFontFamily}"
                                            FontSize="16"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Glyph="&#xf413;" />
                                        <TextBlock
                                            x:Name="TextSelectionCloneToNewBoard"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            FlowDirection="{x:Static loc:WpfLanguage.TextDirection}"
                                            Text="{loc:Text Canvas.SendToBoard}" />
                                    </ikw:SimpleStackPanel>
                                </Button>
                            </ikw:SimpleStackPanel>
                            <ikw:SimpleStackPanel VerticalAlignment="Center" Spacing="4">
                                <Border
                                    Height="33"
                                    Padding="5,0"
                                    Background="{DynamicResource FloatBarBackground}"
                                    CornerRadius="3">
                                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="1.5">
                                        <ui:FontIcon
                                            Width="18"
                                            Height="18"
                                            FontFamily="{StaticResource FluentIconFontFamily}"
                                            FontSize="14"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Glyph="&#xe7ad;">
                                            <ui:FontIcon.RenderTransformOrigin>
                                                <Point X="0.5" Y="0.5" />
                                            </ui:FontIcon.RenderTransformOrigin>
                                            <ui:FontIcon.RenderTransform>
                                                <TransformGroup>
                                                    <RotateTransform Angle="90" />
                                                    <ScaleTransform ScaleX="1" ScaleY="-1" />
                                                </TransformGroup>
                                            </ui:FontIcon.RenderTransform>
                                        </ui:FontIcon>
                                        <TextBlock
                                            Margin="0,0,2,0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            FlowDirection="{x:Static loc:WpfLanguage.TextDirection}"
                                            Text="{loc:Text Canvas.RotateLeft}" />
                                        <Button
                                            Width="30"
                                            Height="30"
                                            Padding="0"
                                            Background="{DynamicResource FloatBarBackground}"
                                            Click="BtnAnticlockwiseRotate15_Click">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Foreground="{DynamicResource FloatBarForeground}"
                                                Text="15°" />
                                        </Button>
                                        <Button
                                            Width="30"
                                            Height="30"
                                            Padding="0"
                                            Background="{DynamicResource FloatBarBackground}"
                                            Click="BtnAnticlockwiseRotate45_Click">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Foreground="{DynamicResource FloatBarForeground}"
                                                Text="45°" />
                                        </Button>
                                        <Button
                                            Width="30"
                                            Height="30"
                                            Padding="0"
                                            Background="{DynamicResource FloatBarBackground}"
                                            Click="BtnAnticlockwiseRotate90_Click">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Foreground="{DynamicResource FloatBarForeground}"
                                                Text="90°" />
                                        </Button>
                                    </ikw:SimpleStackPanel>
                                </Border>
                                <Border
                                    Height="33"
                                    Padding="5,0"
                                    Background="{DynamicResource FloatBarBackground}"
                                    CornerRadius="3">
                                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="1.5">
                                        <ui:FontIcon
                                            Width="18"
                                            Height="18"
                                            FontFamily="{StaticResource FluentIconFontFamily}"
                                            FontSize="14"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            Glyph="&#xe7ad;">
                                            <ui:FontIcon.RenderTransformOrigin>
                                                <Point X="0.5" Y="0.5" />
                                            </ui:FontIcon.RenderTransformOrigin>
                                            <ui:FontIcon.RenderTransform>
                                                <RotateTransform Angle="-90" />
                                            </ui:FontIcon.RenderTransform>
                                        </ui:FontIcon>
                                        <TextBlock
                                            Margin="0,0,2,0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Foreground="{DynamicResource FloatBarForeground}"
                                            FlowDirection="{x:Static loc:WpfLanguage.TextDirection}"
                                            Text="{loc:Text Canvas.RotateRight}" />
                                        <Button
                                            Width="30"
                                            Height="30"
                                            Padding="0"
                                            Background="{DynamicResource FloatBarBackground}"
                                            Click="BtnClockwiseRotate15_Click">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Foreground="{DynamicResource FloatBarForeground}"
                                                Text="15°" />
                                        </Button>
                                        <Button
                                            Width="30"
                                            Height="30"
                                            Padding="0"
                                            Background="{DynamicResource FloatBarBackground}"
                                            Click="BtnClockwiseRotate45_Click">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Foreground="{DynamicResource FloatBarForeground}"
                                                Text="45°" />
                                        </Button>
                                        <Button
                                            Width="30"
                                            Height="30"
                                            Padding="0"
                                            Background="{DynamicResource FloatBarBackground}"
                                            Click="BtnClockwiseRotate90_Click">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Foreground="{DynamicResource FloatBarForeground}"
                                                Text="90°" />
                                        </Button>
                                    </ikw:SimpleStackPanel>
                                </Border>
                            </ikw:SimpleStackPanel>
