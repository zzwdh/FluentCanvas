<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="FloatBarBackground" Opacity="0.75" Color="White" />
    <SolidColorBrush x:Key="FloatBarBackgroundWithoutOpacity" Opacity="0.75" Color="White" />
    <SolidColorBrush x:Key="FloatBarTitleBackground" Opacity="0.25" Color="#588bfc" />
    <SolidColorBrush x:Key="FloatBarBorderBrush" Opacity="0.8" Color="Black" />
    <SolidColorBrush x:Key="FloatBarForeground" Color="Black" />
    <Color x:Key="FloatBarForegroundColor">#FF666666</Color>

    <SolidColorBrush x:Key="FloatingToolbarSurfaceBrush" Color="#FAF8F9FB" />
    <LinearGradientBrush x:Key="FloatingToolbarColorfulSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FAE5EDFF" />
        <GradientStop Offset="1" Color="#FAE4F6ED" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="FloatingToolbarHeaderBrush" Color="#FFF0F2F5" />
    <SolidColorBrush x:Key="FloatingToolbarStrokeBrush" Color="#260F172A" />
    <SolidColorBrush x:Key="FloatingToolbarHoverBrush" Color="#100F172A" />
    <SolidColorBrush x:Key="FloatingToolbarPressedBrush" Color="#200F172A" />
    <SolidColorBrush x:Key="FloatingToolbarHoverStrokeBrush" Color="Transparent" />
    <SolidColorBrush x:Key="FloatingToolbarSelectedBrush" Color="#140F172A" />
    <SolidColorBrush x:Key="FloatingToolbarAccentBrush" Color="{DynamicResource {x:Static SystemColors.AccentColorKey}}" />

    <SolidColorBrush x:Key="SettingsPageForeground" Color="Black" />
    <SolidColorBrush x:Key="SettingsPageAnnotationForeground" Color="#666666" />
    <SolidColorBrush x:Key="SettingsPageBorderBrush" Opacity="0.8" Color="Black" />
    <SolidColorBrush x:Key="SettingsPageBackground" Opacity="0.95" Color="White" />

    <SolidColorBrush x:Key="RedBrush" Color="DarkRed" />
    <SolidColorBrush x:Key="PurpleBrush" Color="DarkBlue" />

    <Color x:Key="FloatBarButtonBackgroundKey">Transparent</Color>
    <Color x:Key="FloatBarButtonBackgroundPointerOverKey">#66FFFFFF</Color>
    <Color x:Key="FloatBarButtonButtonBackgroundPressedKey">#99FFFFFF</Color>
</ResourceDictionary>
