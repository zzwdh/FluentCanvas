<UserControl
    x:Class="FluentCanvas.Views.NotificationsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:FluentCanvas.Localization">
    <Grid
        Name="GridNotifications"
        Margin="0,110"
        HorizontalAlignment="Center"
        VerticalAlignment="Bottom"
        Visibility="Collapsed">
        <Border
            MaxHeight="200"
            Padding="20,10"
            Background="{DynamicResource NotificationSurfaceBrush}"
            BorderBrush="{DynamicResource NotificationBorderBrush}"
            BorderThickness="1.5"
            CornerRadius="10"
            Opacity="{DynamicResource NotificationSurfaceOpacity}">
            <TextBlock
                Name="TextBlockNotice"
                FlowDirection="{x:Static loc:WpfLanguage.TextDirection}"
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16"
                Foreground="{DynamicResource NotificationTextBrush}"
                Text="{Binding Message}" />
        </Border>
    </Grid>
</UserControl>
