<Window
    x:Class="FluentCanvas.YesOrNoNotificationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:loc="clr-namespace:FluentCanvas.Localization"
    xmlns:local="clr-namespace:FluentCanvas"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    Title="{loc:Text Presentation.ConfirmationTitle}"
    Width="450"
    MinHeight="160"
    ui:WindowHelper.SystemBackdropType="{DynamicResource ConfirmationBackdrop}"
    ui:WindowHelper.UseModernWindowStyle="True"
    FlowDirection="{x:Static loc:WpfLanguage.TextDirection}"
    Language="{x:Static loc:WpfLanguage.Language}"
    ResizeMode="NoResize"
    SizeToContent="Height"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid Background="{DynamicResource FloatBarBackground}">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="35" />
            </Grid.RowDefinitions>
            <Viewbox Height="30" Margin="10" HorizontalAlignment="Left">
                <ui:FontIcon
                    Width="30"
                    Height="22"
                    FontFamily="{StaticResource FluentIconFontFamily}"
                    FontSize="20"
                    Foreground="{DynamicResource FloatBarForeground}"
                    Glyph="&#xe786;" />
            </Viewbox>
            <TextBlock
                Name="Label"
                Margin="60,8,10,8"
                VerticalAlignment="Center"
                Foreground="{DynamicResource FloatBarForeground}"
                TextWrapping="Wrap" />
            <ikw:SimpleStackPanel Grid.Row="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="10">
                <Button
                    Width="100"
                    Margin="0"
                    Click="ButtonYes_Click"
                    Content="{loc:Text Presentation.Yes}"
                    Style="{DynamicResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}" />
                <Button Width="100" Margin="0" Click="ButtonNo_Click" Content="{loc:Text Presentation.No}" />
            </ikw:SimpleStackPanel>
        </Grid>
    </Grid>
</Window>
