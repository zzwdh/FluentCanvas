<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <RuntimeFrameworkVersion>$(FluentCanvasDesktopRuntimeVersion)</RuntimeFrameworkVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FluentCanvas</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../FluentCanvas/Classroom/*.cs" Link="Classroom/%(Filename)%(Extension)" />
    <Compile Include="../../FluentCanvas/Localization/UiText.cs" Link="Localization/UiText.cs" />
    <EmbeddedResource Include="../../FluentCanvas/Localization/*.resx" Link="Localization/%(Filename)%(Extension)" />
    <Compile Include="../../FluentCanvas.CanvasCore/AtomicFile.cs;../../FluentCanvas/Helpers/InkActivation.cs;../../FluentCanvas/Helpers/SettingsStorage.cs;../../FluentCanvas/Helpers/DelAutoSavedFiles.cs;../../FluentCanvas/Services/ISettingsService.cs;../../FluentCanvas/Services/LocalSettingsService.cs;../../FluentCanvas/Resources/Settings.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../../FluentCanvas/Services/ErrorReporting.cs" Link="ErrorReporting.cs" />
    <Compile Include="../../FluentCanvas/Services/SettingsPreferenceEditor.cs;../../FluentCanvas/Services/NumericPreference.cs;../../FluentCanvas/Services/WinUiSettingsRequest.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../../FluentCanvas/Resources/SettingsPresets.cs" Link="SettingsPresets.cs" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Sentry" />
  </ItemGroup>
</Project>
